{
  // Tests and scripts run in Node; kept apart so browser code in src/ cannot
  // accidentally lean on Node globals such as `process` or `Buffer`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/**/*.spec.ts", "scripts", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
