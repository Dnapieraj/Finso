{
  "name": "@vireo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./styles/*": "./src/styles/*",
    "./tokens": "./src/tokens/index.ts"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.ts\" vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --coverage",
    "generate:theme": "node scripts/generate-theme.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@vireo/shared": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vireo/config": "workspace:*",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
