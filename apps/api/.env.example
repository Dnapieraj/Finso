# Skopiuj do .env i uzupełnij lokalnie. Ten plik NIE zawiera sekretów.

NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://finso:finso@localhost:5432/finso?schema=public"

# Klucz HMAC access tokenów, min. 32 znaki. Wygeneruj własny:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Opcjonalne — wartości domyślne w src/config/env.ts:
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# AUTH_THROTTLE_LIMIT=10
# AUTH_THROTTLE_TTL_SECONDS=60
