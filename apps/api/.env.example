# Skopiuj do .env i uzupełnij lokalnie. Ten plik NIE zawiera sekretów.

NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://finso:finso@localhost:5432/finso?schema=public"

# Klucz HMAC access tokenów, min. 32 znaki. Wygeneruj własny:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
# Klucz HMAC kodów z e-maili (reset hasła, potwierdzenie adresu), min. 32 znaki,
# inny niż JWT_ACCESS_SECRET. Wygeneruj tak samo jak wyżej.
EMAIL_CODE_SECRET=
# Wysyłka e-maili przez Resend. Bez klucza (lokalnie) e-maile z kodami trafiają
# do logu serwera; na produkcji klucz jest wymagany.
# RESEND_API_KEY=
# MAIL_FROM="Finso <kontakt@finso.app>"
# Opcjonalne — wartości domyślne w src/config/env.ts:
# JWT_ACCESS_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# AUTH_THROTTLE_LIMIT=10
# AUTH_THROTTLE_TTL_SECONDS=60
