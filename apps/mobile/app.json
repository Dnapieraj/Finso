{
  "expo": {
    "name": "Finso",
    "slug": "finso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.finso",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.finso",
      "adaptiveIcon": {
        "backgroundColor": "#F5F6F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6F1",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121611"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Finso używa Face ID do odblokowania aplikacji, jeśli włączysz blokadę w Ustawieniach."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Budget",
              "label": "Możesz dziś wydać",
              "description": "Ile możesz dziś wydać i kiedy wypłata.",
              "previewImage": "./assets/widget-preview.png",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "scheme": "finso"
  }
}
