# Adres API widziany Z TELEFONU. "localhost" na telefonie to sam telefon,
# więc podaj adres IP komputera w sieci Wi-Fi (Windows: ipconfig,
# macOS/Linux: ifconfig), np. http://192.168.0.106:3000.
# Emulator Androida: http://10.0.2.2:3000. Symulator iOS: http://localhost:3000.
EXPO_PUBLIC_API_URL=http://192.168.0.106:3000

# Zgłaszanie awarii (Sentry). Puste = nic nie jest wysyłane (lokalnie i w CI).
# Dla buildów do sklepu ustaw w EAS (docs/PUBLIKACJA.md), np.
# https://<klucz>@o<org>.ingest.de.sentry.io/<projekt> — region UE.
EXPO_PUBLIC_SENTRY_DSN=
